#include <bits/stdc++.h>
using namespace std;
 
int main(){
    int t;
    cin >> t;
    while(t--){
        string s;
        cin >> s;
        int cnt =0;
        if(s.length() % 2 != 0) cout << "NO" << endl;
        else{
            for(int i=0; i<s.length()/2; i++){
                if(s[i] == s[i+(s.length()/2)]){
                    cnt++;
                }
            }
            if(cnt == (s.length()/2)) cout << "YES" << endl;
            else cout << "NO" << endl;
        }
    }
}