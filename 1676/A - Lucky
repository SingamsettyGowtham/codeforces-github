#include <bits/stdc++.h>
using namespace std;
 
int main(){
    int t; cin >> t;
    while(t--){
        string s; cin >> s;
        int first_three = 0, last_three = 0;
        for(int i=0; i<6; i++){
            if(i < 3){
                int num1 = s[i] -'0';
                first_three += num1;
            }
            else{
                int num2 = s[i] -'0';
                last_three += num2;
            }
        }
        if(first_three == last_three) cout << "YES" << endl;
        else cout << "NO" << endl;
    }
}