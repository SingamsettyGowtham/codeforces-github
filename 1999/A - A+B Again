#include <bits/stdc++.h>
using namespace std;
 
int main(){
    int t;
    cin >> t;
    while(t--){
        int a;
        cin >> a;
        int sum=0;
        int n;
        while(a > 0){
            n = a%10;
            sum += n;
            a /= 10;
        }
        cout << sum << endl;
    }
}